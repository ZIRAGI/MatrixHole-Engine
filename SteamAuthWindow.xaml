<Window x:Class="MatrixHole.SteamAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Authorization" Height="600" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#060608" WindowStyle="None">
    <Window.Resources>
        <Style x:Key="SteamBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#c73e1d" BorderBrush="#c73e1d" BorderThickness="1" 
                                CornerRadius="8" Padding="0,0,0,1">
                            <Border.Effect>
                                <DropShadowEffect Color="#c73e1d" BlurRadius="16" Opacity="0.25" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e54d2e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#e54d2e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2a2a38"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1a1a24"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" BlurRadius="0" Opacity="0" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExitBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#101016" BorderBrush="#1e1e2e" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a24"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2a2a38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#060608" BorderBrush="#1a1a24" BorderThickness="1">
        <Grid>
            <!-- Subtle background glow -->
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.25" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#1a0a08" Offset="0"/>
                    <GradientStop Color="#060608" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="#0c0c10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="MatrixHole-Engine" Foreground="#e54d2e" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0" FontFamily="Segoe UI" Opacity="0.8"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="44" Height="32" Background="Transparent" BorderThickness="0" 
                        Click="Close_Click" Margin="0,0,4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                <Grid Width="12" Height="12">
                                    <Path x:Name="crossPath" Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="#5a5a6a" StrokeThickness="1.5" 
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1a1a24"/>
                                    <Setter TargetName="crossPath" Property="Stroke" Value="#e8e8f0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Content (no ScrollViewer) -->
            <Grid Grid.Row="1" Margin="32,20,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Image x:Name="LogoImage" Width="180" Height="180" Margin="0,0,0,16"
                       HorizontalAlignment="Center" Stretch="UniformToFill" Grid.Row="0">
                    <Image.Clip>
                        <EllipseGeometry Center="90,90" RadiusX="90" RadiusY="90"/>
                    </Image.Clip>
                </Image>

                <TextBlock Grid.Row="1" Text="Steam Authorization" FontSize="22" FontWeight="Bold" 
                           Foreground="#e8e8f0" TextAlignment="Center" Margin="0,0,0,4" FontFamily="Segoe UI"/>
                <TextBlock Grid.Row="2" Text="Link your account to continue" FontSize="12" 
                           Foreground="#5a5a6a" TextAlignment="Center" Margin="0,0,0,20" FontFamily="Segoe UI"/>

                <!-- Info card -->
                <Border Grid.Row="3" Background="#0c0c10" BorderBrush="#1a1a24" BorderThickness="1" 
                        CornerRadius="12" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#1a1a24" 
                                    BorderBrush="#2a2a38" BorderThickness="1" Margin="0,0,12,0">
                                <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Steam Sign-In Required" FontSize="13" FontWeight="600" 
                                           Foreground="#e8e8f0" FontFamily="Segoe UI"/>
                                <TextBlock Text="All players must sign in" FontSize="11" 
                                           Foreground="#5a5a6a" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="12" 
                                   LineHeight="18" FontFamily="Segoe UI">
                            Sign in with your Steam account to start using MatrixHole-Engine. Your settings will be saved automatically and synced across sessions. We never store your password.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <TextBlock x:Name="StatusText" Grid.Row="4" Text="Waiting for action..." FontSize="11"
                           Foreground="#444" FontFamily="JetBrains Mono, Consolas, monospace" 
                           TextAlignment="Center" Margin="0,0,0,16"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <Button x:Name="ExitBtn" Content="Exit" Width="110" Height="40" Margin="0,0,10,0"
                            Background="#101016" Foreground="#e8e8f0" BorderBrush="#1a1a24" FontSize="12" 
                            FontFamily="Segoe UI" Click="ExitBtn_Click" Style="{StaticResource ExitBtn}"/>
                    <Button x:Name="LoginBtn" Width="170" Height="40"
                            Background="#c73e1d" Foreground="#ffffff" BorderBrush="#c73e1d" FontSize="12" 
                            FontFamily="Segoe UI" Click="LoginBtn_Click" Style="{StaticResource SteamBtn}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Login with Steam" VerticalAlignment="Center" FontWeight="600"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
