<Window x:Class="MatrixHole.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MatrixHole Engine" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="icon.ico"
        MinWidth="900" MinHeight="600"
>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0"
                      CornerRadius="0" ResizeBorderThickness="8"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6a6a7a"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Margin="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1a1a2a"/>
                    <Setter Property="Foreground" Value="#e8e8f0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarClose" TargetType="Button" BasedOn="{StaticResource TitleBarBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff5252"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PremiumBadge" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00f0ff" Offset="0"/>
                        <GradientStop Color="#b829dd" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Background="#0a0a0f" 
            BorderBrush="#1a1a2e" 
            BorderThickness="1"
            CornerRadius="0"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="0" BlurRadius="40" Color="#000000" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0a0a0f" Offset="0"/>
                        <GradientStop Color="#0f0f1a" Offset="0.5"/>
                        <GradientStop Color="#0a0a0f" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Ambient glow -->
                    <Rectangle HorizontalAlignment="Left" Width="300" Height="44" Opacity="0.25">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00f0ff" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle HorizontalAlignment="Right" Width="200" Height="44" Opacity="0.12">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#b829dd" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    
                    <!-- Top accent line -->
                    <Rectangle VerticalAlignment="Top" Height="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#00f0ff" Offset="0.2"/>
                                <GradientStop Color="#b829dd" Offset="0.5"/>
                                <GradientStop Color="#00f0ff" Offset="0.8"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    
                    <!-- Bottom separator -->
                    <Rectangle VerticalAlignment="Bottom" Height="1" Fill="#1a1a2e"/>

                    <!-- Logo + Title + Badge -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <Image Source="logo_new.png" Width="24" Height="24" Stretch="Uniform" 
                               RenderOptions.BitmapScalingMode="HighQuality"
                               UseLayoutRounding="True" SnapsToDevicePixels="True"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Image.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="#00f0ff" Opacity="0.4"/>
                            </Image.Effect>
                        </Image>
                        <TextBlock Text="MatrixHole" VerticalAlignment="Center"
                                   Foreground="#f0f0f5" FontWeight="800" FontSize="14" 
                                   FontFamily="Inter,Segoe UI"/>
                        <TextBlock Text="Engine" VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="#a0a0b8" FontWeight="400" FontSize="14" 
                                   FontFamily="Inter,Segoe UI"/>
                        <Border Style="{StaticResource PremiumBadge}">
                            <TextBlock Text="PRO" FontSize="9" FontWeight="800" Foreground="#0a0a0f" FontFamily="Inter,Segoe UI"/>
                        </Border>
                    </StackPanel>
                    
                    <!-- Window Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" Margin="0,0,8,0">
                        <Button Style="{StaticResource TitleBarBtn}" Click="Minimize_Click" ToolTip="Minimize">
                            <Path Data="M0,6 L12,6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="None"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarBtn}" Click="Maximize_Click" ToolTip="Maximize">
                            <Path Data="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="None"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarClose}" Click="Close_Click" ToolTip="Close">
                            <Path Data="M1.5,1.5 L10.5,10.5 M1.5,10.5 L10.5,1.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="None"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <Border Grid.Row="1" ClipToBounds="True">
                <wpf:WebView2 x:Name="WebView" xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                              DefaultBackgroundColor="#0a0a0f"/>
            </Border>
        </Grid>
    </Border>
</Window>
