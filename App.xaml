<Application x:Class="MatrixHole.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBase" Color="#0a0a0f"/>
        <SolidColorBrush x:Key="BgCard" Color="#111118"/>
        <SolidColorBrush x:Key="BgCardHover" Color="#1a1a24"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#e8e8f0"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6c6c7f"/>
        <SolidColorBrush x:Key="Accent" Color="#E54D2E"/>
        <SolidColorBrush x:Key="AccentHover" Color="#ff6b4a"/>
        <SolidColorBrush x:Key="Border" Color="#22222c"/>
    </Application.Resources>
</Application>
