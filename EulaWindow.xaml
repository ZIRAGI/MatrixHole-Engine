<Window x:Class="MatrixHole.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Agreement" Height="660" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None"
        FontFamily="Segoe UI" AllowsTransparency="True"
        Opacity="0">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.6">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <Window.Resources>
        <!-- CheckBox with smooth check appearance -->
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#a0a0b0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="checkBorder" Width="18" Height="18" Background="#0a0a0e"
                                    BorderBrush="#2a2a38" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                                <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True">
                                    <Path x:Name="checkMark" Data="M 4.5 8.5 L 7.5 11.5 L 11.5 4.5" Stroke="#e8e8f0" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" SnapsToDevicePixels="True"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#c73e1d"/>
                                <Setter TargetName="checkBorder" Property="Background" Value="#c73e1d"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="(Path.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="(Path.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="(Path.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="checkMark" Storyboard.TargetProperty="(Path.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBorder" Property="BorderBrush" Value="#3a3a48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollBar -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#3a3a48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Decline Button -->
        <Style x:Key="DeclineBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderBrush" Value="#1e1e28"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1a1a24"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#c73e1d"/>
                                <Setter Property="Foreground" Value="#e8e8f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accept Button with strong pulse -->
        <Style x:Key="AcceptBtn" TargetType="Button">
            <Setter Property="Background" Value="#c73e1d"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#c73e1d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="600"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glow layer behind the button -->
                            <Border x:Name="glowBorder" Background="Transparent" BorderThickness="0" CornerRadius="8" Margin="-4">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glow" Color="#c73e1d" BlurRadius="24" Opacity="0.5" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="16,0">
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e54d2e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#e54d2e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#2a2a38"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1a1a24"/>
                                <Setter TargetName="content" Property="TextElement.Foreground" Value="#5a5a6a"/>
                                <Setter TargetName="glowBorder" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="Button.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity"
                                                         From="0.4" To="0.75" Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius"
                                                         From="20" To="32" Duration="0:0:1.2">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#060608" BorderBrush="#1a1a24" BorderThickness="1">
        <Grid>
            <!-- Animated background mesh -->
            <Grid.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#0c0c14" Offset="0"/>
                    <GradientStop Color="#060608" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ambient orbs -->
            <Ellipse Width="500" Height="500" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-150,-150,0" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#c73e1d" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.05" To="0.12" Duration="0:0:4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <Ellipse Width="350" Height="350" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-100,0,0,-100" Opacity="0.05">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5865F2" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.03" To="0.08" Duration="0:0:5"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#0c0c10" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#1e1e28" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Grid>
                    <Rectangle HorizontalAlignment="Left" Width="140" Height="40" Opacity="0.4">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#30c73e1d" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle VerticalAlignment="Bottom" Height="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#c73e1d" Offset="0"/>
                                <GradientStop Color="#1a1a24" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="License Agreement" Foreground="#e54d2e" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="16,0" FontFamily="Segoe UI" Opacity="0.9"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="44" Height="32" Background="Transparent" BorderThickness="0"
                            Click="Close_Click" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                                    <Grid Width="12" Height="12">
                                        <Path x:Name="crossPath" Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="#5a5a6a" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Background" Value="#1a1a24"/>
                                        <Setter TargetName="crossPath" Property="Stroke" Value="#e8e8f0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="32,24,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with shimmer gradient -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock FontSize="24" FontWeight="800" FontFamily="Segoe UI" Text="End User License Agreement">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#e8e8f0" Offset="0"/>
                                <GradientStop Color="#c0c0d0" Offset="0.5"/>
                                <GradientStop Color="#e8e8f0" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="MatrixHole-Engine [BETA]" FontSize="12"
                               Foreground="#6c6c7f" FontFamily="Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Animated accent divider -->
                <Border Grid.Row="1" Height="1" Margin="0,0,0,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#c73e1d" Offset="0"/>
                            <GradientStop Color="#e54d2e" Offset="0.3"/>
                            <GradientStop Color="#1e1e28" Offset="0.7"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- EULA Text with rotating gradient border -->
                <Grid Grid.Row="2">
                    <Border CornerRadius="12" BorderThickness="1" Padding="1">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1e1e28" Offset="0"/>
                                <GradientStop Color="#c73e1d" Offset="0.5"/>
                                <GradientStop Color="#1e1e28" Offset="1"/>
                                <LinearGradientBrush.RelativeTransform>
                                    <RotateTransform CenterX="0.5" CenterY="0.5"/>
                                </LinearGradientBrush.RelativeTransform>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.BorderBrush).(LinearGradientBrush.RelativeTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Border Background="#0a0a0e" CornerRadius="11" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.45" ShadowDepth="0"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,24,16,24">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                                </ScrollViewer.Resources>
                                <TextBlock x:Name="EulaTextBlock" TextWrapping="Wrap" Foreground="#a0a0b0"
                                           FontSize="12" LineHeight="26" FontFamily="Segoe UI"/>
                            </ScrollViewer>
                        </Border>
                    </Border>
                </Grid>

                <!-- Checkbox -->
                <CheckBox x:Name="AcceptCheckBox" Grid.Row="3"
                          Content="I have read and agree to the terms above"
                          Style="{StaticResource DarkCheckBox}" Margin="0,20,0,0"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="DeclineBtn" Content="Decline" Width="120" Height="42" Margin="0,0,10,0"
                            Style="{StaticResource DeclineBtn}" Click="DeclineBtn_Click"/>
                    <Button x:Name="AcceptBtn" Content="Accept" Width="120" Height="42"
                            Style="{StaticResource AcceptBtn}" IsEnabled="False" Click="AcceptBtn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
